# Database Configuration (Clever Cloud injects POSTGRESQL_ADDON_URI automatically)
DATABASE_URL=postgresql://user:password@host:6041/database

# Redis Configuration (Clever Cloud injects REDIS_ADDON_* automatically)
REDIS_HOST=your-redis-host.services.clever-cloud.com
REDIS_PORT=6379
REDIS_PASSWORD=your-redis-password

# Application Configuration
APP_NAME="Clever AI Team"
ENVIRONMENT=production
LOG_LEVEL=INFO
LOG_FORMAT=json

# Security
SECRET_KEY=generate-a-long-random-secret-key

# Bootstrap admin (optional, created at startup if missing)
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# LLM Provider Configuration (configure at least one for real inference;
# otherwise a deterministic mock provider keeps the platform testable)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=
OLLAMA_BASE_URL=
LITELLM_PROXY_URL=
LITELLM_PROXY_API_KEY=

# Default models
DEFAULT_ORCHESTRATOR_MODEL=gpt-4o-mini
DEFAULT_SPECIALIST_MODEL=gpt-4o-mini

# Embeddings
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536

# Workers / concurrency
# WEB_CONCURRENCY=       # override (2 x cores) + 1
MAX_WEB_WORKERS=9
ENABLE_BACKGROUND_WORKERS=true

# Orchestrator
ORCHESTRATOR_STALL_LIMIT=4
MAX_DIALECTICAL_REVIEW_ITERATIONS=3
RUN_TIMEOUT_SECONDS=900

# Sandbox
SANDBOX_ENABLED=true
SANDBOX_TIMEOUT=30
SANDBOX_MAX_MEMORY_MB=512

# CORS
ALLOWED_ORIGINS=*
